<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>N14 Control</vendor>
  <action id="org.n14control.modify-cpu">
    <description>Change CPU frequency ceilings and Turbo Boost</description>
    <message>Authentication is required to let N14 Control change CPU limits.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
  </action>
  <action id="org.n14control.modify-ec">
    <description>Control COLORFUL N14 fans and keyboard lighting</description>
    <message>Allow the active local N14 Control session to control fans and keyboard lighting.</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
  </action>
</policyconfig>